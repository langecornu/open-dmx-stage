{
  "name": "open-dmx-stage",
  "version": "0.1.0",
  "description": "Open DMX Stage: design, program and run DMX lighting scenes and chases from the browser.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run test:server && npm run test:web",
    "test:server": "node --import ./tests/server/setup.js --test tests/server/*.test.js",
    "test:web": "vitest run",
    "test:coverage": "npm run test:coverage:server && npm run test:coverage:web",
    "test:coverage:server": "node --import ./tests/server/setup.js --test --experimental-test-coverage --test-coverage-lines=85 --test-coverage-branches=80 --test-coverage-functions=85 tests/server/*.test.js",
    "test:coverage:web": "vitest run --coverage",
    "size": "node scripts/check-bundle-size.js",
    "licenses": "node scripts/check-licenses.js",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "dmx:ramp": "node scripts/dmx-ramp.js"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "fast-xml-parser": "^5.12.0",
    "helmet": "^8.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^5.1.0",
    "axe-core": "^4.14.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.4.2",
    "typescript": "~5.9.3",
    "vite": "^6.0.7",
    "vitest": "^3.2.7"
  }
}
