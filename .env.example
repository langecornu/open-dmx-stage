# Open DMX Stage configuration (all optional)
PORT=4000
# Comma-separated list of allowed browser origins (the Vite dev server by default)
ALLOWED_ORIGINS=http://localhost:5173
# mock | enttec-pro
DMX_DRIVER=mock
# Serial path of the Enttec DMX USB Pro, e.g. /dev/tty.usbserial-EN123456
DMX_SERIAL_PATH=
# DMX frames sent per second (1-44)
DMX_FRAME_RATE=30
# Where the project JSON is stored
DATA_DIR=server/data
