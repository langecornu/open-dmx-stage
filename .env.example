# Open DMX Stage configuration (all optional)
PORT=4000
# Address to listen on. The default (loopback) keeps the control surface on this computer. Use 0.0.0.0 only on a
# network you trust, to control it from a phone or tablet (and add that page's origin to ALLOWED_ORIGINS).
HOST=127.0.0.1
# Comma-separated list of allowed browser origins (the Vite dev server by default)
ALLOWED_ORIGINS=http://localhost:5173
# mock | open-dmx | enttec-pro | artnet | sacn  (you can also choose this in the app, on the Output screen)
DMX_DRIVER=mock
# Serial port for open-dmx / enttec-pro, e.g. /dev/tty.usbserial-XXXX or COM3
DMX_SERIAL_PATH=
# Art-Net / sACN destination IP (empty = broadcast / multicast) and universe
DMX_NET_HOST=
# DMX_UNIVERSE=0
# DMX frames sent per second (1-44)
DMX_FRAME_RATE=30
# Online fixture search in the Fixtures screen (searches the Open Fixture Library). false = never contact the internet
OFL_ENABLED=true
# Anthropic API key for AI shows. Optional: it can also be pasted on the Settings screen, where it is never shown again
# ANTHROPIC_API_KEY=
# Where the project JSON is stored
DATA_DIR=server/data
# development | production | test (production switches log output to JSON)
NODE_ENV=development
# debug | info | warn | error | silent
LOG_LEVEL=info
# text | json (default: text in development, json in production)
# LOG_FORMAT=text
