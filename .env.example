# Open DMX Stage configuration (all optional)
PORT=4000
# Comma-separated list of allowed browser origins (the Vite dev server by default)
ALLOWED_ORIGINS=http://localhost:5173
# mock | open-dmx | enttec-pro | artnet | sacn  (you can also choose this in the app, on the Output screen)
DMX_DRIVER=mock
# Serial port for open-dmx / enttec-pro, e.g. /dev/tty.usbserial-XXXX or COM3
DMX_SERIAL_PATH=
# Art-Net / sACN destination IP (empty = broadcast / multicast) and universe
DMX_NET_HOST=
# DMX_UNIVERSE=0
# DMX frames sent per second (1-44)
DMX_FRAME_RATE=30
# Where the project JSON is stored
DATA_DIR=server/data
